<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="20dp">

    <!-- Loading indicator (Material3) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/load_state_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="40dp"
        app:trackCornerRadius="4dp" />

    <!-- Error icon: only visible with error text -->
    <ImageView
        android:id="@+id/load_state_error_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning_amber_24dp"
        android:visibility="gone"
        app:tint="?attr/colorError" />

    <!-- Error message -->
    <TextView
        android:id="@+id/load_state_error_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <!-- Retry button: visually separated from the text above -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/load_state_retry_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/error_retry"
        android:visibility="gone"
        app:strokeColor="?attr/colorError" />

</LinearLayout>

