<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_3d_light_blue"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/sensor_station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Station"
            android:textColor="#01579B"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/sensor_station_id_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:text="SEIS-01"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/sensor_station_name"
            app:layout_constraintStart_toEndOf="@id/sensor_station_name"
            app:layout_constraintTop_toTopOf="@id/sensor_station_name" />

        <TextView
            android:id="@+id/sensor_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="Bandung, Indonesia"
            android:textColor="#546E7A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_location_small"
            app:layout_constraintEnd_toStartOf="@id/sensor_status_badge"
            app:layout_constraintStart_toStartOf="@id/sensor_station_name"
            app:layout_constraintTop_toBottomOf="@id/sensor_station_id_badge" />

        <TextView
            android:id="@+id/sensor_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_3d_green_small"

            android:backgroundTint="@null"

            android:gravity="center"
            android:minWidth="70dp"

            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"

            android:text="Online"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/sensor_stats_badges_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/sensor_station_name"
            app:layout_constraintTop_toBottomOf="@id/sensor_location">

            <LinearLayout
                android:id="@+id/sensor_last_ping_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_badge_3d_white"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="60dp"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST PING"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sensor_last_ping_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 min ago"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="2 min ago" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sensor_rssi_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_badge_3d_white"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="60dp"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RSSI"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sensor_rssi_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-53 dBm"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sensor_latency_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_3d_white"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="60dp"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="9dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATENCY"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sensor_latency_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24ms"
                    android:textColor="#424242"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>