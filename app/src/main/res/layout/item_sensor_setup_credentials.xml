<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3: Home Wi-Fi Credentials -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="56dp"
            android:paddingBottom="16dp">

            <!-- 3D icon circle — perfectly centered -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_onboarding_icon_3d" />

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/key"
                    app:tint="#FFFFFF"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <View android:layout_width="1dp" android:layout_height="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_badge_3d_grey_small"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="Step 3 of 3"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sensor_setup_credentials_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Home Wi-Fi Credentials"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.15"
                android:letterSpacing="-0.01" />

            <View android:layout_width="1dp" android:layout_height="16dp" />

            <TextView
                android:id="@+id/sensor_setup_credentials_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Enter your home Wi-Fi credentials so the sensor can connect to the internet."
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.5" />

            <View android:layout_width="1dp" android:layout_height="28dp" />

            <!-- SSID field (opens bottom sheet) -->
            <EditText
                android:id="@+id/sensor_setup_ssid_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field_3d"
                android:hint="Wi-Fi Network Name (SSID)"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface"
                android:singleLine="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:drawableEnd="@drawable/ic_arrow_drop_down" />

            <View android:layout_width="1dp" android:layout_height="12dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/sensor_setup_pass_input"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field_3d"
                    android:hint="Wi-Fi Password"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurface"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:fontFamily="monospace"
                    android:typeface="monospace" />

                <ImageView
                    android:id="@+id/sensor_setup_pass_toggle"
                    android:layout_width="48dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="13dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="Toggle Password Visibility"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Close / Exit button — top-left corner -->
    <ImageView
        android:id="@+id/sensor_setup_btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        android:layout_gravity="top|start"
        android:src="@drawable/ic_close_white_24dp"
        app:tint="?attr/colorOnSurface"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:padding="8dp" />

</FrameLayout>
