<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:id="@+id/warning_scanning_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:contentDescription="@string/warning_screen_scanning_content_description"
        android:focusable="true">

        <!-- 3D radar container (consistent with app design language) -->
        <FrameLayout
            android:id="@+id/warning_radar_container"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_circle_3d_green"
            android:padding="16dp">
            <ImageView
                android:id="@+id/warning_radar_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.9"
                android:contentDescription="@string/warning_radar_icon_content_description"
                android:importantForAccessibility="yes"
                android:src="@drawable/ic_radar"
                app:tint="#4CAF50" />
        </FrameLayout>

        <!-- 3D status pill (server + sensor count), same style as Sensors screen -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/warning_status_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pill_3d_blue"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <View
                android:id="@+id/warning_status_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/badge_circle"
                android:backgroundTint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/warning_status_pill_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/warning_status_pill_connecting"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/warning_status_dot"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/warning_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.1"
            android:text="@string/warning_status_connecting"
            android:textColor="#2196F3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/warning_status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/warning_subtitle_connecting"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/warning_alert_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_emergency_red"
        android:contentDescription="@string/warning_screen_alert_content_description"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:contentDescription="@string/warning_alert_icon_content_description"
                android:importantForAccessibility="yes"
                android:src="@drawable/alert_triangle"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/warning_earthquake_alert_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/warning_intensity_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VII"
                android:textColor="#FFFFFF"
                android:textSize="100sp"
                android:includeFontPadding="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/warning_alert_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_rounded_translucent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Estimated Distance: 45 km"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_marginVertical="24dp"
                android:alpha="0.5"
                android:background="#FFFFFF"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/warning_alert_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.9"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Time: 21:05:15 WIB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/warning_safe_actions_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:contentDescription="@string/warning_safe_actions_button_content_description"
                android:text="@string/warning_what_should_i_do"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="16dp"
                app:icon="@drawable/help_circle"
                app:iconTint="#000000"
                android:textColor="#B71C1C" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/warning_safe_actions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/warning_safe_actions_card_content_description"
                android:visibility="gone"
                app:cardBackgroundColor="#CCFFFFFF"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/warning_life_saving_actions"
                        android:textColor="#B71C1C"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/warning_drop"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• COVER: Protect your head and neck under a sturdy table."
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/warning_hold_on"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/warning_share_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/warning_share_button_content_description"
                    android:text="@string/warning_share"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/warning_dismiss_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/warning_dismiss_button_content_description"
                    android:text="@string/warning_dismiss"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:importantForAccessibility="no" /> </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/bottom_floating_ui"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/warning_view_logs_content_description"
        app:backgroundTint="#333333"
        app:elevation="6dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_notification"
        app:tint="#FFFFFF"
        app:useCompatPadding="false" />
</FrameLayout>