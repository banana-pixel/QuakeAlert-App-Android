<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- 3D icon circle -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="105dp"
            android:layout_gravity="center">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_icon_3d" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginBottom="3dp"
                android:src="@drawable/ic_onboarding_test"
                android:contentDescription="Test icon" />

        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp" />

        <!-- Title (theme-adaptive for dark mode visibility) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Test Your\nAlerts"
            android:textColor="@color/onboarding_page_title"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Send a test notification to make sure everything is working. This simulates a max-priority earthquake alert."
            android:textColor="@color/onboarding_page_desc"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.45" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <!-- 3D Keep Alerting toggle card (light blue - matches History/Sensors) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_3d_light_blue"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="22dp"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep Alerting"
                        android:textColor="#01579B"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Sound alarm continuously until you dismiss the notification"
                        android:textColor="#546E7A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingMultiplier="1.3" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/onboarding_test_insistent_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:contentDescription="Keep alerting toggle" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp" />

        <!-- 3D Red test button -->
        <TextView
            android:id="@+id/onboarding_test_send_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_onboarding_btn_test_3d"
            android:gravity="center"
            android:text="Send Test Alert"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Status text (theme-adaptive for dark mode visibility) -->
        <TextView
            android:id="@+id/onboarding_test_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/onboarding_page_desc"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
