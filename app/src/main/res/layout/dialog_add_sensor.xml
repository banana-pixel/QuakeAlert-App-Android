<?xml version="1.0" encoding="utf-8"?>
<!--
  Add Sensor Wizard — dialog_add_sensor.xml
  Material 3 + QuakeAlert 3D style. No hardcoded hex colours.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header: ← Add New Sensor -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btn_nav_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back_white_24dp"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Add New Sensor"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btn_nav_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- ViewFlipper – 3 Steps -->
    <ViewFlipper
        android:id="@+id/view_flipper_sensor_setup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- STEP 1: WiFi Connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Main 3D card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_3d_light_blue_sensor"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp"
                android:gravity="center_horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_step_1"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 of 3"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp"
                    app:chipIconVisible="false"
                    app:ensureMinTouchTargetSize="false" />

                <!-- WiFi status icon – tinted dynamically by Fragment -->
                <ImageView
                    android:id="@+id/iv_wifi_status_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_wifi_large"
                    android:scaleType="centerInside"
                    android:contentDescription="@null"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_step1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Searching for&#10;sensor&#8230;"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- Progress dots: 3 active / 2 inactive -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:background="@drawable/dot_inactive"
                        android:backgroundTint="?attr/colorTertiary" />
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/dot_inactive"
                        android:backgroundTint="?attr/colorTertiary" />
                    <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/dot_inactive"
                        android:backgroundTint="?attr/colorTertiary" />
                    <View android:id="@+id/dot_4"
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/dot_inactive"
                        android:backgroundTint="?attr/colorSurfaceVariant" />
                    <View android:id="@+id/dot_5"
                        android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/dot_inactive"
                        android:backgroundTint="?attr/colorSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <!-- Instruction card (MaterialCardView with M3 secondary container) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wifi_large"
                        android:scaleType="centerInside"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <TextView
                        android:id="@+id/tv_step1_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Connect your phone&#8217;s WiFi to &#8216;Quake-Setup&#8217; network first"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSecondaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step1_continue"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_3d_blue_sensor"
                android:enabled="false"
                android:alpha="0.5"
                android:text="Connected, Continue &#8594;"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@android:color/white"
                app:backgroundTint="@null"
                app:cornerRadius="50dp"
                app:icon="@null" />

        </LinearLayout>

        <!-- STEP 2: GPS Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Main 3D card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_3d_light_blue_sensor"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp"
                android:gravity="center_horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_step_2"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 of 3"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp"
                    app:chipIconVisible="false"
                    app:ensureMinTouchTargetSize="false" />

                <!-- Location icon tinted primary (green in QuakeAlert) -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_location_large"
                    android:scaleType="centerInside"
                    android:contentDescription="@null"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_step2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Location Found!"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- Coordinates chip: white oval, M3 Assist style -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_coordinates"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Fetching&#8230;"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp"
                    app:chipIconVisible="false"
                    app:ensureMinTouchTargetSize="false" />

                <TextView
                    android:id="@+id/tv_accuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accuracy: &#177;&#8212; meters"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step2_send"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_3d_green_sensor"
                android:text="Send to Sensor &#8594;"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@android:color/white"
                app:backgroundTint="@null"
                app:cornerRadius="50dp"
                app:icon="@null" />

        </LinearLayout>

        <!-- STEP 3: Wi-Fi Configuration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- Main card fills available space -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_3d_light_blue_sensor"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_step_3"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Step 3 of 3"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipStrokeWidth="0dp"
                    app:chipIconVisible="false"
                    app:ensureMinTouchTargetSize="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Select Wi-Fi Network"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ListView
                    android:id="@+id/lv_wifi_scan"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="16dp"
                    android:divider="?attr/colorOutlineVariant"
                    android:dividerHeight="1px"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/tv_selected_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Selected: None"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_wifi_password"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Wi-Fi Password"
                    app:endIconMode="password_toggle"
                    app:boxStrokeColor="?attr/colorOutline"
                    app:hintTextColor="?attr/colorOnSurfaceVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_wifi_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="?attr/colorOnSurface"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_step3_finish"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_3d_green_sensor"
                android:text="Finish Setup &#8594;"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@android:color/white"
                app:backgroundTint="@null"
                app:cornerRadius="50dp"
                app:icon="@null" />

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
