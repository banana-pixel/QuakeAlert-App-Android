<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <!-- 3D icon circle -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="105dp"
            android:layout_gravity="center">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_icon_3d" />

            <ImageView
                android:id="@+id/onboarding_perm_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginBottom="3dp"
                android:contentDescription="Permission icon" />

        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp" />

        <!-- Title (theme-adaptive: dark blue in light mode, light blue in dark mode) -->
        <TextView
            android:id="@+id/onboarding_perm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/onboarding_page_title"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15" />

        <!-- Required/Optional 3D badge -->
        <TextView
            android:id="@+id/onboarding_perm_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp" />

        <!-- Description (theme-adaptive: gray in light mode, lighter gray in dark mode) -->
        <TextView
            android:id="@+id/onboarding_perm_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/onboarding_page_desc"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.5" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <!-- 3D Permission card (light blue - matches History/Sensors) -->
        <LinearLayout
            android:id="@+id/onboarding_perm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_3d_light_blue"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="20dp">

            <!-- 3D Permission action button -->
            <TextView
                android:id="@+id/onboarding_perm_action_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_onboarding_btn_action_3d"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <!-- Status text (shown after granting) - dark green on light blue card -->
            <LinearLayout
                android:id="@+id/onboarding_perm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_onboarding_check"
                    android:contentDescription="Granted" />

                <TextView
                    android:id="@+id/onboarding_perm_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/onboarding_perm_granted"
                    android:textColor="@color/intensity_green"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
