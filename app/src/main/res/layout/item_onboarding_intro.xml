<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp">

        <!-- 3D icon circle -->
        <FrameLayout
            android:layout_width="130dp"
            android:layout_height="135dp"
            android:layout_gravity="center">

            <View
                android:id="@+id/onboarding_icon_circle"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_onboarding_icon_3d" />

            <ImageView
                android:id="@+id/onboarding_icon"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:layout_marginBottom="3dp"
                android:contentDescription="Page icon" />

        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp" />

        <!-- Title (theme-adaptive for dark mode visibility) -->
        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/onboarding_page_title"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15"
            android:letterSpacing="-0.01" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp" />

        <!-- Subtitle (theme-adaptive for dark mode visibility) -->
        <TextView
            android:id="@+id/onboarding_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/onboarding_page_desc"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.5" />

    </LinearLayout>

</ScrollView>
