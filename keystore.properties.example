# Copy this file to keystore.properties and fill in your release keystore details.
# keystore.properties is gitignored — never commit it.
#
# Create a keystore with:
#   keytool -genkey -v -keystore quakealert-release.keystore -alias quakealert -keyalg RSA -keysize 2048 -validity 10000
#
storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=quakealert
storeFile=/path/to/quakealert-release.keystore
